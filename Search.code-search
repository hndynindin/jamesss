# ContextLines: 1

<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>QuizGuard - Interactive Quiz & Exam Engine</title>
<style>
:root{
  --bg:#f4f7fb;--card:#ffffff;--text:#132238;--muted:#5b6b7f;--line:#d9e2ec;
  --primary:#1d4ed8;--primary2:#1e40af;--ok:#15803d;--bad:#b91c1c;--warn:#b45309;
  --shadow:0 12px 32px rgba(15,23,42,.12);--radius:18px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
body{min-height:100vh}
button,input,select{font:inherit}
button{cursor:pointer}
button:disabled{cursor:not-allowed;opacity:.55}
.shell{max-width:1120px;margin:auto;padding:20px}
.topbar{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:18px}
.brand{font-size:1.25rem;font-weight:800;letter-spacing:.2px}
.badge{padding:7px 11px;border-radius:999px;background:#e8eefc;color:#153b8f;font-weight:700;font-size:.86rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:22px}
.grid{display:grid;gap:18px}
.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
h1,h2,h3{margin-top:0}
h1{font-size:clamp(1.8rem,5vw,3rem);line-height:1.05}
p{line-height:1.55}
.muted{color:var(--muted)}
label{display:block;font-weight:700;margin-bottom:7px}
input,select{width:100%;padding:12px 13px;border:1px solid #bac7d5;border-radius:12px;background:#fff;color:var(--text);outline:none}
input:focus,select:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.15)}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.btn{border:0;border-radius:12px;padding:12px 16px;font-weight:800;background:#e7edf5;color:#1d2c42}
.btn.primary{background:var(--primary);color:#fff}
.btn.primary:hover{background:var(--primary2)}
.btn.danger{background:#fee2e2;color:#991b1b}
.btn.success{background:#dcfce7;color:#166534}
.btn.warn{background:#ffedd5;color:#9a3412}
.hidden{display:none!important}
.hero{padding:34px 24px;text-align:center}
.hero p{max-width:760px;margin:0 auto 20px}
.subjects{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.subject{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff;text-align:left;transition:.15s transform,.15s box-shadow}
.subject:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(15,23,42,.09)}
.subject b{display:block;font-size:1rem;margin-bottom:5px}
.subject small{color:var(--muted)}
.exam-head{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;margin-bottom:14px}
.timer{font-size:1.25rem;font-weight:900;padding:10px 14px;border-radius:12px;background:#eff6ff;color:#1d4ed8;min-width:130px;text-align:center}
.timer.low{background:#fff7ed;color:#c2410c}
.progress{height:10px;background:#e5e7eb;border-radius:999px;overflow:hidden;margin:12px 0 20px}
.progress>div{height:100%;background:#2563eb;width:0%}
.qmeta{font-weight:800;color:#334155;margin-bottom:8px}
.question{font-size:1.25rem;line-height:1.5;margin:0 0 18px}
.options{display:grid;gap:10px}
.opt{display:grid;grid-template-columns:38px 1fr;gap:10px;align-items:start;border:1px solid #cbd5e1;border-radius:14px;padding:12px;background:#fff;text-align:left}
.opt:hover:not(:disabled){border-color:#60a5fa;background:#f8fbff}
.opt .letter{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#edf2f7;font-weight:900}
.opt.correct{border-color:#22c55e;background:#f0fdf4}
.opt.wrong{border-color:#ef4444;background:#fef2f2}
.feedback{margin-top:16px;border-radius:14px;padding:14px 16px;font-weight:800}
.feedback.ok{background:#dcfce7;color:#166534}
.feedback.bad{background:#fee2e2;color:#991b1b}
.feedback.info{background:#eff6ff;color:#1e40af}
.stat{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}
.stat .n{font-size:2rem;font-weight:900}
.table-wrap{overflow:auto}
table{width:100%;border-collapse:collapse;min-width:760px}
th,td{text-align:left;border-bottom:1px solid var(--line);padding:11px 9px;vertical-align:top}
th{background:#f8fafc;position:sticky;top:0}
.status{display:inline-block;padding:4px 8px;border-radius:999px;font-size:.78rem;font-weight:800}
.status.active{background:#dbeafe;color:#1e40af}
.status.done{background:#dcfce7;color:#166534}
.status.locked{background:#fee2e2;color:#991b1b}
.notice{border-left:4px solid #3b82f6;background:#eff6ff;padding:12px 14px;border-radius:8px;margin:14px 0}
.notice.warn{border-color:#f59e0b;background:#fff7ed}
.notice.bad{border-color:#ef4444;background:#fef2f2}
.modal{position:fixed;inset:0;background:rgba(15,23,42,.72);display:grid;place-items:center;padding:16px;z-index:9999}
.modal .box{max-width:560px;width:100%;background:#fff;border-radius:20px;padding:24px;box-shadow:var(--shadow)}
.lock-screen{position:fixed;inset:0;background:#450a0a;color:#fff;z-index:10000;display:grid;place-items:center;padding:20px;text-align:center}
.lock-screen .inner{max-width:650px}
.lock-screen h1{font-size:clamp(2rem,8vw,4rem)}
.qr{width:220px;height:220px;object-fit:contain;border:1px solid var(--line);border-radius:12px;background:#fff}
.watermark{position:fixed;inset:0;pointer-events:none;z-index:999;overflow:hidden;opacity:.055;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(5,1fr);transform:rotate(-20deg);font-size:18px;font-weight:900}
.watermark span{display:flex;align-items:center;justify-content:center;white-space:nowrap}
.small{font-size:.9rem}
hr{border:0;border-top:1px solid var(--line);margin:20px 0}
@media(max-width:760px){
  .shell{padding:12px}
  .card{padding:16px;border-radius:14px}
  .grid.two,.grid.three,.subjects{grid-template-columns:1fr}
  .topbar{align-items:flex-start}
  .exam-head{grid-template-columns:1fr}
  .timer{width:100%}
  .hero{padding:24px 14px}
  .subject{padding:15px}
  .question{font-size:1.12rem}
}
@media print{body{display:none!important}}
</style>
</head>
<body>
<div id="app" class="shell"></div>
<div id="watermark" class="watermark hidden"></div>
<div id="lockScreen" class="lock-screen hidden">
  <div class="inner">
    <h1>UJIAN TERKUNCI</h1>
    <p id="lockMessage">Pelanggaran terdeteksi. Ujian hanya dapat dilanjutkan setelah direset oleh guru.</p>
  </div>
</div>

<script>
"use strict";

/* =========================================================
   QUIZGUARD - 1 FILE APP
   HTML + CSS + JS Native + localStorage
   ========================================================= */

const APP_KEY = "quizguard_v1";
const TEACHER_PIN = "1234";
const SUBJECTS = {
  bindo:{name:"Bahasa Indonesia", count:25, minutes:60},
  pkwu:{name:"PKWU", count:25, minutes:60},
  tkj:{name:"TKJ", count:20, minutes:120},
  bing:{name:"Bahasa Inggris", count:25, minutes:60, modes:["reading","listening"]},
  mtk:{name:"Matematika", count:20, minutes:120},
  pai:{name:"PAI", count:25, minutes:60},
  pkn:{name:"PKN", count:25, minutes:60},
  pjok:{name:"PJOK", count:25, minutes:60},
  ipas:{name:"IPAS", count:25, minutes:60}
};

const $ = (s)=>document.querySelector(s);
const app = $("#app");

function defaultState(){
  return {
    profile:{name:"",className:""},
    attempts:[],
    activeExam:null,
    teacherLoggedIn:false,
    lastView:"home"
  };
}
function loadState(){
  try{
    const raw=localStorage.getItem(APP_KEY);
    return raw ? {...defaultState(),...JSON.parse(raw)} : defaultState();
  }catch(e){
    console.error(e);
    return defaultState();
  }
}
let state=loadState();
function saveState(){ localStorage.setItem(APP_KEY,JSON.stringify(state)); }
function uid(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,8); }
function esc(v=""){ return String(v).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m])); }
function shuffle(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}
function clamp(n,min,max){ return Math.max(min,Math.min(max,n)); }
function nowISO(){ return new Date().toISOString(); }
function scoreOf(correct,total){ return total ? Math.round((correct/total)*100) : 0; }

function layout(content, badge="QuizGuard"){
  return `
  <div class="topbar">
    <div class="brand">🛡️ QuizGuard</div>
    <div class="badge">${esc(badge)}</div>
  </div>
  ${content}`;
}

/* ---------- Bank Soal ---------- */
const Q = (q,correct,wrong,extra={}) => ({q,correct,wrong,...extra});

const BANK = {
bindo:[
Q("Kalimat yang memiliki satu subjek dan satu predikat disebut ...","kalimat tunggal",["kalimat majemuk","kalimat langsung","kalimat tidak langsung","kalimat perintah"]),
