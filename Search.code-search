function generateMathQuestions(){
  const out=[];
  for(let i=0;i<20;i++){
    const a=4+i, b=2+(i%7);
    const answer=a+b;
    const wrong=[answer+1,answer-1,answer+2,answer-2].map(String);
    out.push(Q(`Hasil dari ${a} + ${b} adalah ...`,String(answer),wrong));
  }
  return out;
}
BANK.mtk=generateMathQuestions();

function buildListeningBank(){
  const data=[
    ["The library opens at seven in the morning.","When does the library open?","At seven in the morning.",["At six.","At eight.","At noon.","At night."]],
    ["Rina goes to school by bicycle every day.","How does Rina go to school?","By bicycle.",["By bus.","By car.","On foot.","By train."]],
    ["The red bag is under the wooden table.","Where is the red bag?","Under the wooden table.",["On the table.","Beside the door.","In the cupboard.","Behind the chair."]],
    ["Tom has two brothers and one sister.","How many brothers does Tom have?","Two.",["One.","Three.","Four.","Five."]],
    ["The meeting starts at half past nine.","What time does the meeting start?","At 9:30.",["At 8:30.","At 9:00.","At 10:00.","At 10:30."]],
    ["Sarah likes apples, but she does not like bananas.","Which fruit does Sarah like?","Apples.",["Bananas.","Oranges.","Grapes.","Mangoes."]],
    ["The science class is on Monday afternoon.","When is the science class?","Monday afternoon.",["Tuesday morning.","Monday morning.","Friday afternoon.","Wednesday evening."]],
    ["My father works in a hospital as a doctor.","Where does the speaker's father work?","In a hospital.",["In a school.","In a bank.","In a market.","In a hotel."]],
    ["The weather today is cloudy and cool.","How is the weather today?","Cloudy and cool.",["Hot and sunny.","Stormy.","Snowy.","Very dry."]],
    ["Please bring a pencil, an eraser, and a ruler.","Which item should be brought?","A ruler.",["A plate.","A spoon.","A towel.","A helmet."]]
  ];
  const out=[];
  for(let i=0;i<25;i++){
    const d=data[i%data.length];
    out.push(Q(d[1],d[2],d[3],{audio:d[0]}));
  }
  return out;
}
const LISTENING_BANK=buildListeningBank();

/* ---------- Penyusunan soal ---------- */
function prepareQuestions(subject, mode){
  const meta=SUBJECTS[subject];
  let pool=(subject==="bing" && mode==="listening") ? LISTENING_BANK : BANK[subject];
  pool=shuffle(pool).slice(0,meta.count);
  return pool.map((item,idx)=>{
    const options=shuffle([item.correct,...item.wrong]);
    return {
      id:`${subject}-${Date.now()}-${idx}-${Math.random().toString(36).slice(2,6)}`,
      q:item.q,
      audio:item.audio||null,
      options,
      correct:item.correct,
      chosen:null,
      isCorrect:null
    };
  });
}

/* ---------- Home / Login ---------- */
function renderHome(){
  clearWatermark();
  $("#lockScreen").classList.add("hidden");
  state.lastView="home"; saveState();
  const p=state.profile;
  app.innerHTML=layout(`
    <section class="card hero">
      <h1>Interactive Quiz & Exam Engine</h1>
      <p class="muted">Ujian pilihan ganda A–E, timer, soal dan pilihan jawaban diacak, koreksi otomatis, penyimpanan LocalStorage, dashboard guru, serta proteksi dasar saat ujian.</p>
      ${state.activeExam ? `<div class="notice warn"><b>Ada ujian yang belum selesai.</b><br>${esc(SUBJECTS[state.activeExam.subject].name)} — ${esc(state.activeExam.studentName)} (${esc(state.activeExam.className)})</div>`:""}
      <div class="row" style="justify-content:center">
        <button class="btn primary" id="studentBtn">Masuk sebagai Siswa</button>
        <button class="btn" id="teacherBtn">Masuk sebagai Guru</button>
        ${state.activeExam ? `<button class="btn success" id="resumeBtn">Lanjutkan Ujian</button>`:""}
      </div>
    </section>
    <div class="grid two" style="margin-top:18px">
      <section class="card">
        <h3>Fitur Utama</h3>
        <p class="muted small">Data pada versi ini disimpan di browser menggunakan <b>localStorage</b>. Refresh halaman tidak menghapus progres.</p>
        <div class="notice">PIN guru demo: <b>1234</b>. Ganti nilai konstanta <code>TEACHER_PIN</code> di kode jika diperlukan.</div>
      </section>
      <section class="card">
        <h3>Catatan Teknis</h3>
        <p class="muted small">Monitoring guru berbasis LocalStorage hanya melihat data pada browser/origin yang sama. Untuk memantau banyak HP secara real-time diperlukan server/database bersama.</p>
      </section>
    </div>
  `,"Beranda");
  $("#studentBtn").onclick=renderStudentLogin;
  $("#teacherBtn").onclick=renderTeacherLogin;
  if($("#resumeBtn")) $("#resumeBtn").onclick=resumeExam;
}

function renderStudentLogin(){
  const p=state.profile;
  app.innerHTML=layout(`
  <section class="card">
    <h2>Identitas Siswa</h2>
    <div class="grid two">
      <div><label>Nama</label><input id="nameInput" maxlength="60" value="${esc(p.name)}" placeholder="Contoh: Andi Saputra"></div>
      <div><label>Kelas</label><input id="classInput" maxlength="40" value="${esc(p.className)}" placeholder="Contoh: XI TKJ 1"></div>
    </div>
    <div class="row" style="margin-top:18px">
      <button class="btn primary" id="saveProfileBtn">Simpan & Pilih Mapel</button>
      <button class="btn" id="backBtn">Kembali</button>
    </div>
  </section>`,"Mode Siswa");
  $("#saveProfileBtn").onclick=()=>{
    const name=$("#nameInput").value.trim();
    const className=$("#classInput").value.trim();
    if(!name||!className){ alert("Nama dan kelas wajib diisi."); return; }
    state.profile={name,className}; saveState(); renderSubjectSelection();
  };
  $("#backBtn").onclick=renderHome;
}

function renderSubjectSelection(){
  if(!state.profile.name||!state.profile.className) return renderStudentLogin();
  const cards=Object.entries(SUBJECTS).map(([k,v])=>`
    <button class="subject" data-subject="${k}">
      <b>${esc(v.name)}</b>
      <small>${v.count} soal • ${v.minutes} menit${v.modes?" • 2 mode":""}</small>
    </button>`).join("");
  app.innerHTML=layout(`
  <section class="card">
    <div class="row" style="justify-content:space-between">
      <div><h2 style="margin-bottom:4px">Pilih Mata Pelajaran</h2><div class="muted">${esc(state.profile.name)} • ${esc(state.profile.className)}</div></div>
      <button class="btn" id="editProfileBtn">Ubah Nama/Kelas</button>
    </div>
    <hr>
    <div class="subjects">${cards}</div>
    <div class="row" style="margin-top:18px"><button class="btn" id="backBtn">Kembali</button></div>
  </section>`,"Pilih Ujian");
  document.querySelectorAll("[data-subject]").forEach(b=>b.onclick=()=>chooseSubject(b.dataset.subject));
  $("#editProfileBtn").onclick=renderStudentLogin;
  $("#backBtn").onclick=renderHome;
}
function chooseSubject(subject){
  if(state.activeExam){
    alert("Masih ada ujian aktif. Selesaikan atau minta guru mereset.");
    return resumeExam();
  }
  if(subject==="bing"){
    app.innerHTML=layout(`
    <section class="card">
      <h2>Bahasa Inggris</h2>
      <p>Pilih jenis ujian.</p>
      <div class="grid two">
        <button class="subject" id="readingMode"><b>📖 Reading / Question Answer</b><small>25 soal • 60 menit</small></button>
        <button class="subject" id="listeningMode"><b>🎧 Listening</b><small>25 soal • 60 menit • audio via Text-to-Speech browser</small></button>
      </div>
      <div class="row" style="margin-top:18px"><button class="btn" id="cancelMode">Kembali</button></div>
    </section>`,"Bahasa Inggris");
    $("#readingMode").onclick=()=>showStartExam("bing","reading");
    $("#listeningMode").onclick=()=>showStartExam("bing","listening");
    $("#cancelMode").onclick=renderSubjectSelection;
  }else showStartExam(subject,null);
}

function showStartExam(subject,mode){
  const m=SUBJECTS[subject];
  app.innerHTML=layout(`
  <section class="card">
    <h2>Konfirmasi Ujian</h2>
    <div class="grid two">
      <div class="stat"><div class="muted">Mapel</div><div class="n" style="font-size:1.3rem">${esc(m.name)}</div></div>
      <div class="stat"><div class="muted">Durasi</div><div class="n" style="font-size:1.3rem">${m.minutes} menit</div></div>
      <div class="stat"><div class="muted">Jumlah Soal</div><div class="n">${m.count}</div></div>
      <div class="stat"><div class="muted">Mode</div><div class="n" style="font-size:1.3rem">${mode?esc(mode):"Standar"}</div></div>
    </div>
    <div class="notice warn">
      <b>Aturan demo:</b> selama ujian, pindah tab/aplikasi akan dicatat sebagai pelanggaran dan ujian dikunci sampai guru melakukan reset. Copy, paste, klik kanan, dan print diblokir.
    </div>
    <p class="muted small">Catatan: browser web biasa tidak dapat memblokir screenshot sistem operasi 100% dan tidak dapat mendeteksi split-screen secara sempurna.</p>
    <div class="row">
      <button class="btn primary" id="startExamBtn">Mulai Ujian</button>
      <button class="btn" id="cancelExamBtn">Batal</button>
    </div>
  </section>`,"Siap Ujian");
  $("#startExamBtn").onclick=()=>startExam(subject,mode);
  $("#cancelExamBtn").onclick=renderSubjectSelection;
}

/* ---------- Exam ---------- */
let timerHandle=null;
let antiCheatActive=false;
function startExam(subject,mode){
  const meta=SUBJECTS[subject];
  const questions=prepareQuestions(subject,mode);
  const start=Date.now();
  state.activeExam={
    id:uid(),
    studentName:state.profile.name,
    className:state.profile.className,
    subject, mode,
    questions,
    current:0,
    startedAt:new Date(start).toISOString(),
    deadline:start+(meta.minutes*60*1000),
    status:"active",
    violations:[],
    finishedAt:null
  };
  state.attempts.push({
    id:state.activeExam.id,
    studentName:state.profile.name,
    className:state.profile.className,
    subject,mode,
    startedAt:state.activeExam.startedAt,
    status:"active",
    correct:0,wrong:0,score:null,
    violations:[],
    answers:[]
  });
  saveState();
  requestFullscreenSafe();
  renderExam();
}

function resumeExam(){
  if(!state.activeExam) return renderHome();
  if(state.activeExam.status==="locked") return showLock(state.activeExam.violations.at(-1)?.reason||"Pelanggaran");
  renderExam();
}

function requestFullscreenSafe(){
  const el=document.documentElement;
  if(el.requestFullscreen) el.requestFullscreen().catch(()=>{});
}

function renderExam(){
  const ex=state.activeExam;
  if(!ex) return renderHome();
  if(ex.status==="locked") return showLock("Pelanggaran terdeteksi.");
  const remaining=ex.deadline-Date.now();
  if(remaining<=0){ finishExam(true); return; }
  antiCheatActive=true;
  installWatermark(ex.studentName,ex.className);
  const q=ex.questions[ex.current];
  const answered=q.chosen!==null;
  const letters=["A","B","C","D","E"];
  app.innerHTML=layout(`
    <section class="card">
      <div class="exam-head">
        <div>
          <h2 style="margin-bottom:4px">${esc(SUBJECTS[ex.subject].name)}</h2>
          <div class="muted">${esc(ex.studentName)} • ${esc(ex.className)}</div>
        </div>
        <div class="timer" id="timerBox">--:--:--</div>
      </div>
      <div class="qmeta">Soal ${ex.current+1} dari ${ex.questions.length}</div>
      <div class="progress"><div style="width:${((ex.current+1)/ex.questions.length)*100}%"></div></div>
      ${q.audio?`<div class="notice"><b>🎧 Listening</b><br><button class="btn primary" id="playAudioBtn" style="margin-top:8px">Putar Audio</button><span class="muted small"> Gunakan speaker/headset.</span></div>`:""}
      <p class="question">${esc(q.q)}</p>
      <div class="options">
        ${q.options.map((o,i)=>{
          let cls="opt";
          if(answered && o===q.correct) cls+=" correct";
          if(answered && o===q.chosen && o!==q.correct) cls+=" wrong";
          return `<button class="${cls}" data-option="${esc(o)}" ${answered?"disabled":""}>
            <span class="letter">${letters[i]}</span><span>${esc(o)}</span>
          </button>`;
        }).join("")}
      </div>
      <div id="feedbackArea">
        ${answered ? feedbackHTML(q) : ""}
      </div>
      <div class="row" style="margin-top:18px">
        ${answered?`<button class="btn primary" id="nextBtn">${ex.current===ex.questions.length-1?"Selesaikan Ujian":"Soal Berikutnya"}</button>`:""}
      </div>
    </section>`,"Ujian Berlangsung");
  document.querySelectorAll("[data-option]").forEach(b=>b.onclick=()=>answerCurrent(b.dataset.option));
  if($("#nextBtn")) $("#nextBtn").onclick=nextQuestion;
  if($("#playAudioBtn")) $("#playAudioBtn").onclick=()=>speak(q.audio);
  startTimer();
}

function feedbackHTML(q){
  return q.isCorrect
    ? `<div class="feedback ok">✓ Benar. Jawaban: ${esc(q.correct)}</div>`
    : `<div class="feedback bad">✕ Salah. Jawaban yang benar: ${esc(q.correct)}</div>`;
}
function answerCurrent(choice){
  const ex=state.activeExam;
  if(!ex||ex.status!=="active") return;
  const q=ex.questions[ex.current];
  if(q.chosen!==null) return;
  q.chosen=choice;
  q.isCorrect=choice===q.correct;
  syncAttempt();
  saveState();
  renderExam();
}
function nextQuestion(){
  const ex=state.activeExam;
  if(!ex) return;
  const q=ex.questions[ex.current];
  if(q.chosen===null){ alert("Pilih jawaban terlebih dahulu."); return; }
  if(ex.current>=ex.questions.length-1) finishExam(false);
  else{ ex.current++; saveState(); renderExam(); }
}
function syncAttempt(){
  const ex=state.activeExam; if(!ex) return;
  const at=state.attempts.find(a=>a.id===ex.id); if(!at) return;
  const answered=ex.questions.filter(q=>q.chosen!==null);
  at.answers=answered.map(q=>({q:q.q,chosen:q.chosen,correct:q.correct,isCorrect:q.isCorrect}));
  at.correct=answered.filter(q=>q.isCorrect).length;
  at.wrong=answered.filter(q=>!q.isCorrect).length;
  at.violations=[...ex.violations];
}
function startTimer(){
  clearInterval(timerHandle);
  const tick=()=>{
    const ex=state.activeExam; if(!ex) return clearInterval(timerHandle);
    const ms=ex.deadline-Date.now();
    if(ms<=0){ clearInterval(timerHandle); finishExam(true); return; }
    const s=Math.floor(ms/1000), h=Math.floor(s/3600), m=Math.floor((s%3600)/60), sec=s%60;
    const box=$("#timerBox");
    if(box){
      box.textContent=`${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}:${String(sec).padStart(2,"0")}`;
      box.classList.toggle("low",s<300);
    }
  };
  tick(); timerHandle=setInterval(tick,1000);
}
function finishExam(timeout=false){
  clearInterval(timerHandle); antiCheatActive=false;
  const ex=state.activeExam; if(!ex) return;
  ex.status="done"; ex.finishedAt=nowISO();
  syncAttempt();
  const at=state.attempts.find(a=>a.id===ex.id);
  const answered=ex.questions.filter(q=>q.chosen!==null);
  const correct=answered.filter(q=>q.isCorrect).length;
  const wrong=ex.questions.length-correct;
  at.status="done"; at.finishedAt=ex.finishedAt; at.correct=correct; at.wrong=wrong; at.score=scoreOf(correct,ex.questions.length);
  at.answers=ex.questions.map(q=>({q:q.q,chosen:q.chosen,correct:q.correct,isCorrect:q.isCorrect===true}));
  saveState();
  clearWatermark();
  renderResult(at,timeout);
  state.activeExam=null;
  saveState();
}
function renderResult(at,timeout){
  app.innerHTML=layout(`
  <section class="card">
    <h2>Hasil Ujian</h2>
    ${timeout?`<div class="notice warn"><b>Waktu habis.</b> Ujian diselesaikan otomatis.</div>`:""}
    <div class="grid three">
      <div class="stat"><div class="muted">Nilai</div><div class="n">${at.score}</div></div>
      <div class="stat"><div class="muted">Benar</div><div class="n">${at.correct}</div></div>
      <div class="stat"><div class="muted">Salah/Kosong</div><div class="n">${at.wrong}</div></div>
    </div>
    <h3 style="margin-top:22px">Rekap Jawaban</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>No</th><th>Soal</th><th>Jawaban Kamu</th><th>Jawaban Benar</th><th>Status</th></tr></thead>
        <tbody>${at.answers.map((a,i)=>`<tr>
          <td>${i+1}</td><td>${esc(a.q)}</td><td>${esc(a.chosen??"-")}</td><td>${esc(a.correct)}</td>
          <td>${a.isCorrect?'<span class="status done">Benar</span>':'<span class="status locked">Salah</span>'}</td>
        </tr>`).join("")}</tbody>
      </table>
    </div>
    <div class="row" style="margin-top:18px"><button class="btn primary" id="homeBtn">Kembali ke Beranda</button></div>
  </section>`,"Hasil Ujian");
  $("#homeBtn").onclick=renderHome;
}

/* ---------- Anti-cheat dasar ---------- */
function recordViolation(reason){
  const ex=state.activeExam;
  if(!antiCheatActive||!ex||ex.status!=="active") return;
  const v={reason,time:nowISO()};
  ex.violations.push(v);
  ex.status="locked";
  const at=state.attempts.find(a=>a.id===ex.id);
  if(at){ at.status="locked"; at.violations=[...ex.violations]; }
  saveState();
  showLock(reason);
}
function showLock(reason){
  antiCheatActive=false;
  clearInterval(timerHandle);
  $("#lockMessage").textContent=`Pelanggaran terdeteksi: ${reason}. Ujian harus direset oleh guru.`;
  $("#lockScreen").classList.remove("hidden");
  clearWatermark();
}
document.addEventListener("visibilitychange",()=>{
  if(document.hidden) recordViolation("berpindah tab/aplikasi");
});
document.addEventListener("copy",e=>{ if(antiCheatActive){e.preventDefault();} });
document.addEventListener("paste",e=>{ if(antiCheatActive){e.preventDefault();} });
document.addEventListener("cut",e=>{ if(antiCheatActive){e.preventDefault();} });
document.addEventListener("contextmenu",e=>{ if(antiCheatActive){e.preventDefault();} });
document.addEventListener("keydown",e=>{
  if(!antiCheatActive) return;
  const k=e.key.toLowerCase();
  if((e.ctrlKey||e.metaKey) && ["c","v","x","p","s","u"].includes(k)) e.preventDefault();
  if(e.key==="PrintScreen"){ e.preventDefault(); recordViolation("tombol Print Screen ditekan"); }
});
window.addEventListener("beforeprint",()=>{ if(antiCheatActive) recordViolation("mencoba mencetak halaman"); });

function speak(text){
  if(!("speechSynthesis" in window)){ alert("Browser ini tidak mendukung Text-to-Speech."); return; }
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text);
  u.lang="en-US"; u.rate=.9;
  speechSynthesis.speak(u);
}
function installWatermark(name,className){
  const wm=$("#watermark");
  wm.innerHTML=Array.from({length:15},()=>`<span>${esc(name)} • ${esc(className)}</span>`).join("");
  wm.classList.remove("hidden");
}
function clearWatermark(){ $("#watermark").classList.add("hidden"); $("#watermark").innerHTML=""; }

/* ---------- Guru ---------- */
function renderTeacherLogin(){
  app.innerHTML=layout(`
  <section class="card" style="max-width:520px;margin:auto">
    <h2>Login Guru</h2>
    <label>PIN Guru</label>
    <input id="pinInput" type="password" inputmode="numeric" placeholder="Masukkan PIN">
    <div class="row" style="margin-top:16px">
      <button class="btn primary" id="loginTeacherBtn">Masuk</button>
      <button class="btn" id="backBtn">Kembali</button>
    </div>
  </section>`,"Mode Guru");
  $("#loginTeacherBtn").onclick=()=>{
    if($("#pinInput").value===TEACHER_PIN){
      state.teacherLoggedIn=true; saveState(); renderTeacherDashboard();
    }else alert("PIN guru salah.");
  };
  $("#backBtn").onclick=renderHome;
}
function renderTeacherDashboard(){
  if(!state.teacherLoggedIn) return renderTeacherLogin();
  const attempts=[...state.attempts].reverse();
  const done=attempts.filter(a=>a.status==="done");
  const avg=done.length?Math.round(done.reduce((s,a)=>s+(a.score||0),0)/done.length):0;
  app.innerHTML=layout(`
  <section class="card">
    <div class="row" style="justify-content:space-between">
      <div><h2 style="margin-bottom:4px">Dashboard Guru</h2><div class="muted">Monitoring data yang tersimpan pada browser ini.</div></div>
      <div class="row"><button class="btn" id="qrBtn">QR / Akses HP</button><button class="btn danger" id="logoutTeacherBtn">Keluar Guru</button></div>
    </div>
    <div class="grid three" style="margin-top:18px">
      <div class="stat"><div class="muted">Total Ujian</div><div class="n">${attempts.length}</div></div>
      <div class="stat"><div class="muted">Selesai</div><div class="n">${done.length}</div></div>
      <div class="stat"><div class="muted">Rata-rata Nilai</div><div class="n">${avg}</div></div>
    </div>
    <div class="notice warn small"><b>Penting:</b> LocalStorage tidak tersinkron antarperangkat. Untuk guru memantau HP siswa secara real-time, proyek perlu backend/database bersama (misalnya Firebase/Supabase/server sekolah).</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Siswa</th><th>Mapel</th><th>Status</th><th>Benar</th><th>Salah</th><th>Nilai</th><th>Pelanggaran</th><th>Aksi</th></tr></thead>
        <tbody>
          ${attempts.length?attempts.map(a=>`<tr>
            <td><b>${esc(a.studentName)}</b><br><span class="muted small">${esc(a.className)}</span></td>
            <td>${esc(SUBJECTS[a.subject]?.name||a.subject)}${a.mode?`<br><span class="small muted">${esc(a.mode)}</span>`:""}</td>
            <td>${statusBadge(a.status)}</td>
            <td>${a.correct??0}</td><td>${a.wrong??0}</td><td>${a.score??"-"}</td>
            <td>${a.violations?.length||0}</td>
            <td class="row">
              <button class="btn" data-detail="${a.id}">Detail</button>
              ${(a.status==="locked"||a.status==="active")?`<button class="btn warn" data-reset="${a.id}">Reset</button>`:""}
              <button class="btn danger" data-delete="${a.id}">Hapus</button>
            </td>
          </tr>`).join(""):`<tr><td colspan="8" class="muted">Belum ada data ujian.</td></tr>`}
        </tbody>
      </table>
    </div>
    <div class="row" style="margin-top:18px">
      <button class="btn" id="refreshTeacherBtn">Refresh Data</button>
      <button class="btn danger" id="clearAllBtn">Hapus Semua Riwayat</button>
      <button class="btn" id="homeBtn">Beranda</button>
    </div>
  </section>`,"Dashboard Guru");
  document.querySelectorAll("[data-detail]").forEach(b=>b.onclick=()=>renderAttemptDetail(b.dataset.detail));
  document.querySelectorAll("[data-reset]").forEach(b=>b.onclick=()=>teacherReset(b.dataset.reset));
  document.querySelectorAll("[data-delete]").forEach(b=>b.onclick=()=>teacherDelete(b.dataset.delete));
  $("#refreshTeacherBtn").onclick=renderTeacherDashboard;
  $("#clearAllBtn").onclick=()=>{
    if(confirm("Hapus semua riwayat ujian?")){
      state.attempts=[]; state.activeExam=null; saveState(); renderTeacherDashboard();
    }
  };
  $("#qrBtn").onclick=renderQR;
  $("#logoutTeacherBtn").onclick=()=>{state.teacherLoggedIn=false;saveState();renderHome();};
  $("#homeBtn").onclick=renderHome;
}
function statusBadge(s){
  const map={active:["active","Aktif"],done:["done","Selesai"],locked:["locked","Terkunci"]};
  const x=map[s]||["active",s];
  return `<span class="status ${x[0]}">${esc(x[1])}</span>`;
}
function renderAttemptDetail(id){
  const a=state.attempts.find(x=>x.id===id); if(!a) return renderTeacherDashboard();
  app.innerHTML=layout(`
  <section class="card">
    <h2>Detail Ujian</h2>
    <div class="grid three">
      <div class="stat"><div class="muted">Siswa</div><div style="font-weight:900;font-size:1.2rem">${esc(a.studentName)}<br><span class="muted">${esc(a.className)}</span></div></div>
      <div class="stat"><div class="muted">Nilai</div><div class="n">${a.score??"-"}</div></div>
      <div class="stat"><div class="muted">Status</div><div style="margin-top:8px">${statusBadge(a.status)}</div></div>
    </div>
    <h3 style="margin-top:22px">Pelanggaran</h3>
    ${a.violations?.length?`<ul>${a.violations.map(v=>`<li>${esc(v.reason)} — ${new Date(v.time).toLocaleString("id-ID")}</li>`).join("")}</ul>`:`<p class="muted">Tidak ada pelanggaran tercatat.</p>`}
    <h3>Jawaban</h3>
    <div class="table-wrap"><table>
      <thead><tr><th>No</th><th>Soal</th><th>Jawaban Siswa</th><th>Jawaban Benar</th><th>Status</th></tr></thead>
      <tbody>${(a.answers||[]).map((x,i)=>`<tr><td>${i+1}</td><td>${esc(x.q)}</td><td>${esc(x.chosen??"-")}</td><td>${esc(x.correct)}</td><td>${x.isCorrect?'<span class="status done">Benar</span>':'<span class="status locked">Salah</span>'}</td></tr>`).join("")||`<tr><td colspan="5" class="muted">Belum ada jawaban.</td></tr>`}</tbody>
    </table></div>
    <div class="row" style="margin-top:18px"><button class="btn primary" id="backTeacher">Kembali</button></div>
  </section>`,"Detail Ujian");
  $("#backTeacher").onclick=renderTeacherDashboard;
}
function teacherReset(id){
  const a=state.attempts.find(x=>x.id===id);
  if(!a) return;
  if(!confirm(`Reset ujian ${a.studentName}? Progres aktif akan dihapus.`)) return;
  if(state.activeExam && state.activeExam.id===id){
    state.activeExam=null;
    $("#lockScreen").classList.add("hidden");
  }
  a.status="reset";
  a.score=null;
  saveState();
  alert("Ujian berhasil direset. Siswa dapat memulai ujian baru.");
  renderTeacherDashboard();
}
function teacherDelete(id){
  if(!confirm("Hapus data ujian ini?")) return;
  state.attempts=state.attempts.filter(x=>x.id!==id);
  if(state.activeExam?.id===id) state.activeExam=null;
  saveState(); renderTeacherDashboard();
}

/* ---------- QR ---------- */
function renderQR(){
  const url=location.protocol==="file:" ? "" : location.href.split("#")[0];
  const qrUrl=url ? `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(url)}` : "";
  app.innerHTML=layout(`
  <section class="card" style="text-align:center">
    <h2>Akses dari HP</h2>
    ${url?`
      <img class="qr" src="${qrUrl}" alt="QR Code">
      <p>Scan QR untuk membuka alamat yang sama:</p>
      <input value="${esc(url)}" readonly style="max-width:720px">
      <div class="notice warn small">Agar HP bisa membuka aplikasi, file harus dijalankan melalui web server yang dapat diakses HP pada jaringan yang sama. Jika memakai <code>localhost</code>, ganti dengan IP LAN laptop, misalnya <code>http://192.168.x.x:5500</code>.</div>
    `:`
      <div class="notice warn">QR belum dapat dibuat karena file dibuka langsung melalui <code>file://</code>.<br>Jalankan dengan Live Server / server lokal terlebih dahulu.</div>
    `}
    <p class="muted small">Gambar QR menggunakan layanan publik QR Server, sehingga pembuatan QR membutuhkan internet. Aplikasi ujian utamanya tetap HTML/CSS/JS native.</p>
    <button class="btn primary" id="backTeacher">Kembali ke Dashboard</button>
  </section>`,"QR Akses HP");
  $("#backTeacher").onclick=renderTeacherDashboard;
}

/* ---------- Boot ---------- */
if(state.activeExam?.status==="locked"){
  renderHome();
  showLock(state.activeExam.violations.at(-1)?.reason||"Pelanggaran");
}else if(state.activeExam){
  renderHome();
}else{
  renderHome();
}
</script>
</body>
</html>
