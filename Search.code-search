Q("Catatan keluar masuk uang disebut ...","arus kas",["logo","merek","izin edar","segmentasi"]),
Q("Diskon adalah ...","potongan harga",["tambahan pajak","biaya produksi","modal usaha","laba bersih"]),
Q("Pelanggan yang kembali membeli menunjukkan ...","loyalitas pelanggan",["biaya tetap","utang usaha","stok mati","segmentasi acak"]),
Q("Marketplace adalah ...","platform digital untuk transaksi jual beli",["gudang fisik","mesin produksi","surat izin","jenis pajak"]),
Q("Kualitas pelayanan dapat memengaruhi ...","kepuasan pelanggan",["warna langit","jumlah hari","kode pos","suhu ruangan"]),
Q("Rencana bisnis berfungsi sebagai ...","panduan menjalankan usaha",["pengganti produk","alat untuk menghapus biaya","jaminan pasti untung","cara menghindari konsumen"]),
Q("Stok barang yang terlalu banyak dapat meningkatkan ...","biaya penyimpanan",["jumlah penjualan pasti","kepuasan otomatis","nilai merek otomatis","kecepatan produksi"]),
Q("Pemasaran digital memanfaatkan ...","internet dan media digital",["hanya papan tulis","mesin fotokopi saja","surat pribadi saja","kalkulator saja"]),
Q("Testimoni pelanggan dapat digunakan sebagai ...","bukti sosial",["modal tetap","utang jangka panjang","bahan baku","biaya listrik"]),
Q("Salah satu tujuan pencatatan keuangan adalah ...","mengetahui kondisi usaha",["menghilangkan transaksi","menambah risiko","mengurangi data","menutup pemasaran"]),
Q("Inovasi produk berarti ...","melakukan pembaruan atau pengembangan produk",["menghentikan semua perubahan","meniru tanpa modifikasi","menghapus merek","menjual tanpa target"])
],
tkj:[
Q("Perangkat yang menghubungkan dua jaringan berbeda disebut ...","router",["switch","hub","repeater","access point"]),
Q("Alamat IPv4 terdiri dari ...","32 bit",["16 bit","48 bit","64 bit","128 bit"]),
